POSTGRES_DB=flowboard
POSTGRES_USER=flowboard
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=3000
JWT_SIGNING_KEY=replace-with-a-strong-independent-secret

# Django development runtime. Use independent, randomly generated secrets.
DJANGO_SECRET_KEY=replace-with-a-strong-independent-django-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_LOG_LEVEL=INFO

# Local HTTP security defaults. Enable the HTTPS settings in production.
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
DJANGO_TRUST_PROXY_HEADERS=false

# Gunicorn sizing defaults.
WEB_CONCURRENCY=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
